# Webex OAuth helper for the official Webex Suite MCP server.
# Copy this file to .webex-suite-oauth.env and fill in your Webex OAuth integration values.

WEBEX_OAUTH_CLIENT_ID=
WEBEX_OAUTH_CLIENT_SECRET=
WEBEX_OAUTH_REDIRECT_URI=http://127.0.0.1:8787/callback

# Default scopes below match the official Webex Suite MCP server docs as of 2026-08-29.
# Your Webex OAuth Integration must have each of these scopes enabled, or Webex will reject the auth request.
WEBEX_OAUTH_SCOPES=spark:mcp meeting:schedules_read meeting:schedules_write meeting:participants_read meeting:summaries_read meeting:recordings_read meeting:transcripts_read spark:messages_write spark:messages_read spark:rooms_write spark:rooms_read spark:memberships_write spark:webhooks_write Identity:Organization Identity:Config

WEBEX_OAUTH_AUTHORIZE_URL=https://webexapis.com/v1/authorize
WEBEX_OAUTH_TOKEN_URL=https://webexapis.com/v1/access_token

# Local token storage for the helper app.
WEBEX_OAUTH_TOKEN_STORE_PATH=.webex-suite-oauth.json

# Codex MCP config targets to update after login/refresh. Both use the same access token.
CODEX_CONFIG_PATH=~/.codex/config.toml
CODEX_CONFIG_BACKUP_PATH=~/.codex/config.toml.webex-oauth.backup
CODEX_WEBEX_MESSAGING_MCP_SERVER_NAME=Webex-messaging
CODEX_WEBEX_MESSAGING_MCP_SERVER_URL=https://mcp.webexapis.com/mcp/webex-messaging
CODEX_WEBEX_MEETING_MCP_SERVER_NAME=Webex-meeting
CODEX_WEBEX_MEETING_MCP_SERVER_URL=https://mcp.webexapis.com/mcp/webex-meeting
